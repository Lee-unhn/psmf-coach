# 複製成 .env 後填入你自己的值。.env 不會進 git。
# 全部留空也能跑 demo（template + mock 模式，不寄信、不連 Google）。

# ===== 你的身體數據（換成自己的）=====
SEX=male                 # male / female
AGE=30
HEIGHT_CM=175
START_DATE=2026-01-01    # 計畫起始日 ISO 格式
START_WEIGHT=100
START_BODY_FAT_PCT=35
START_FAT_MASS=35
START_LBM=65
START_VISCERAL_FAT=15
GOAL_WEIGHT=75
PLAN_WEEKS=18

# ===== Gemini（每日教練提示 / 可選；留空則用 template 菜單）=====
# 免費申請：https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ===== Gmail SMTP 寄菜單 / 週報（用「應用程式密碼」，非登入密碼）=====
# 取得：Google 帳戶 → 安全性 → 兩步驟驗證 → 應用程式密碼
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
REPORT_TO_EMAIL=

# ===== Google 表單 / 試算表回填（可選）=====
# 1. 建 Google 表單 → 回應連結到一張試算表
# 2. 試算表設「知道連結的任何人 可檢視」
# 3. SHEET_ID = 試算表網址 /d/ 後那段；SHEET_LOG_TAB = 回應分頁名
# 4. FORM_FILL_URL = 表單填寫連結（會放進每日菜單 email 的按鈕）
SHEET_ID=
SHEET_LOG_TAB=表單回覆
SHEET_MENU_TAB=隔日菜單
FORM_FILL_URL=

# 進階：要「回寫菜單到試算表」才需 service account JSON（放 credentials/service_account.json）
GOOGLE_SA_JSON=credentials/service_account.json
